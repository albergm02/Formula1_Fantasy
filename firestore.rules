rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────
    // Helpers
    // ──────────────────────────────
    function autenticado() {
      return request.auth != null;
    }
    function esPropio(emailRecurso) {
      return autenticado() && request.auth.token.email == emailRecurso;
    }
    function esAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.esAdministrador == true;
    }

    // ──────────────────────────────
    // /usuarios/{correoUsuario}   (indexado por email)
    // ──────────────────────────────
    match /usuarios/{correoUsuario} {
      allow read: if autenticado();
      allow create: if autenticado()
                    && request.auth.token.email == correoUsuario;
      allow update: if autenticado()
                    && request.auth.token.email == correoUsuario
                    && !('esAdministrador' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;
    }

    // ──────────────────────────────
    // /catalogo/{doc}
    // ──────────────────────────────
    match /catalogo/{doc} {
      allow read: if autenticado();
      allow write: if false;
    }

    // ──────────────────────────────
    // /ligas/{idLiga}
    // ──────────────────────────────
    match /ligas/{idLiga} {
      allow read: if autenticado();
      allow create: if autenticado()
                    && request.resource.data.admin == request.auth.token.email;
      allow update: if autenticado()
                    && resource.data.codigo_invitacion == request.resource.data.codigo_invitacion
                    && (
                      resource.data.admin == request.resource.data.admin
                      || resource.data.admin == request.auth.token.email
                    );
      allow delete: if autenticado()
                    && resource.data.admin == request.auth.token.email;
    }

    // ──────────────────────────────
    // /participaciones/{idParticipacion}
    // ──────────────────────────────
    match /participaciones/{idParticipacion} {
      allow read: if autenticado();
      allow create: if autenticado()
                    && request.resource.data.email_usuario == request.auth.token.email;
      allow update: if autenticado()
                    && resource.data.email_usuario == request.resource.data.email_usuario
                    && !('puntos' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('ultimaJornada' in request.resource.data.diff(resource.data).affectedKeys())
                    && (
                      esPropio(resource.data.email_usuario)
                      || get(/databases/$(database)/documents/ligas/$(resource.data.id_liga)).data.admin == request.auth.token.email
                    );
      allow delete: if autenticado() && (
                      esPropio(resource.data.email_usuario)
                      || get(/databases/$(database)/documents/ligas/$(resource.data.id_liga)).data.admin == request.auth.token.email
                    );
    }

    // ──────────────────────────────
    // /mercados/{idMercado}
    // ──────────────────────────────
    match /mercados/{idMercado} {
      allow read: if autenticado();
      allow write: if false;

      // ──────────────────────────────
      // Subcolección de pujas: mercados/{idMercado}/pujas/{idPuja}
      // El front usa el campo `emailUsuario` (camelCase).
      // ──────────────────────────────
      match /pujas/{idPuja} {
        allow read: if autenticado();
        allow create: if autenticado()
                      && request.resource.data.emailUsuario == request.auth.token.email;
        allow update: if autenticado()
                      && resource.data.emailUsuario == request.auth.token.email
                      && request.resource.data.emailUsuario == request.auth.token.email;
        allow delete: if autenticado()
                      && resource.data.emailUsuario == request.auth.token.email;
      }
    }

    // ──────────────────────────────
    // /clausulas/{idClausula}
    // ──────────────────────────────
    match /clausulas/{idClausula} {
      allow read: if autenticado();
      allow create: if autenticado()
                    && request.resource.data.email_atacante == request.auth.token.email;
      allow update: if false;
      allow delete: if false;
    }

    // ──────────────────────────────
    // /notificaciones/{idNotificacion}
    // ──────────────────────────────
    match /notificaciones/{idNotificacion} {
      allow read: if esPropio(resource.data.email_destinatario);
      allow create: if autenticado();
      allow update: if esPropio(resource.data.email_destinatario);
      allow delete: if esPropio(resource.data.email_destinatario);
    }

    // ──────────────────────────────
    // /jornadas/{idJornada}
    // ──────────────────────────────
    match /jornadas/{idJornada} {
      allow read: if autenticado();
      allow write: if false;
    }

    // ──────────────────────────────
    // /actividad/{idEvento}
    // Los eventos los crea SIEMPRE el backend (Cloud Functions con admin SDK,
    // que ignora reglas). Aquí solo permitimos lectura a usuarios autenticados.
    // ──────────────────────────────
    match /actividad/{idEvento} {
      allow read: if autenticado();
      allow write: if false;
    }
  }
}
